% ------------------------------------------------------------------------------
% The 3 Specialized Callout Box Environments
% ------------------------------------------------------------------------------

% 1. Exam Insights Box (Amber border, soft cream background, faGraduationCap icon)
\newtcolorbox{examinsight}[1][]{%
    enhanced,
    breakable,
    colback=examAmberBg,
    colframe=examAmberLine,
    boxrule=0pt,
    leftrule=3.5pt,
    sharp corners,
    rounded corners=all,
    arc=2pt,
    left=12pt,
    right=12pt,
    top=10pt,
    bottom=10pt,
    before skip=14pt,
    after skip=14pt,
    title={\textcolor{examAmber}{\faGraduationCap\enspace\sffamily\bfseries Exam insights\ifstrempty{#1}{}{: #1}}},
    coltitle=examAmber,
    fonttitle=\bfseries\sffamily,
    attach title to upper={\par\vspace{5pt}}
}

% 2. Intuition & Analogy Box (Royal purple border, soft lavender background, faLightbulb icon)
\newtcolorbox{intuition}[1][]{%
    enhanced,
    breakable,
    colback=intuitionPurpleBg,
    colframe=intuitionPurpleLine,
    boxrule=0pt,
    leftrule=3.5pt,
    sharp corners,
    rounded corners=all,
    arc=2pt,
    left=12pt,
    right=12pt,
    top=10pt,
    bottom=10pt,
    before skip=14pt,
    after skip=14pt,
    title={\textcolor{intuitionPurple}{\faLightbulb\enspace\sffamily\bfseries Intuition \& analogy\ifstrempty{#1}{}{: #1}}},
    coltitle=intuitionPurple,
    fonttitle=\bfseries\sffamily,
    attach title to upper={\par\vspace{5pt}}
}

