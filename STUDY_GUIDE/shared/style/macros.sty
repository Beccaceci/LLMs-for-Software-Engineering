\lstdefinestyle{pythonstyle}{
    language=Python,
    basicstyle=\ttfamily\footnotesize\color{bodyDark},
    keywordstyle=\bfseries\color{primaryBlue},
    stringstyle=\color{mintGreen},
    commentstyle=\itshape\color{gray},
    numberstyle=\tiny\color{gray},
    numbers=left,
    numbersep=8pt,
    stepnumber=1,
    tabsize=4,
    showspaces=false,
    showstringspaces=false,
    breaklines=true,
    breakatwhitespace=true,
    columns=flexible,
    keepspaces=true
}

\lstdefinestyle{mactermstyle}{
    basicstyle=\fontsize{8.2pt}{11pt}\ttfamily\color{termtext},
    breaklines=true,
    breakatwhitespace=false,
    keepspaces=true,
    columns=fullflexible,
    frame=none,
    showstringspaces=false
}

\ifcsmacro{solutioncode}{}{%
\newtcblisting[auto counter, number within=chapter]{solutioncode}[2][]{
    enhanced,
    breakable,
    colback=codeBg,
    colframe=steelBlue,
    arc=4pt,
    boxrule=1pt,
    left=6pt,
    right=6pt,
    top=6pt,
    bottom=6pt,
    title=\textsf{\textbf{\small Listing \thetcbcounter: #2}},
    coltitle=white,
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=steelBlue, arc=3pt, boxrule=0pt},
    listing only,
    listing engine=listings,
    listing options={style=pythonstyle},
    #1
}
}

\ifcsmacro{macterminal}{}{%
\newtcblisting{macterminal}[2][]{
    enhanced,
    breakable,
    colback=termbg,
    colframe=termframe,
    colupper=termtext,
    collower=termtext,
    arc=3mm,
    boxrule=0.8pt,
    top=2.5mm,
    bottom=2.5mm,
    left=3.5mm,
    right=3.5mm,
    colbacktitle=termtitlebar,
    coltitle=termtext,
    titlerule=0pt,
    title={%
        \tikz[baseline=-0.6ex]{
            \fill[termred] (0,0) circle (2.8pt);
            \fill[termyellow] (8.5pt,0) circle (2.8pt);
            \fill[termgreen] (17pt,0) circle (2.8pt);
        }\hspace{8pt}\textbf{\sffamily\small\color{termtext}#2}%
    },
    overlay middle and last={},
    middle=2.5mm,
    listing only,
    listing style=mactermstyle,
    before skip=3mm,
    after skip=3mm,
    #1
}
\AddToHook{env/macterminal/after}{\color{black}}
}

