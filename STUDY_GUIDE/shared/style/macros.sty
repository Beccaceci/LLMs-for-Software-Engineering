% ------------------------------------------------------------------------------
% Numbered Definition and Theorem Environments (with cleveref integration)
% ------------------------------------------------------------------------------
\newtcbtheorem[number within=chapter,crefname={definition}{definitions}]{definition}{Definition}{%
    enhanced,
    breakable,
    colback=defBlueBg,
    colframe=defBlueLine,
    boxrule=0pt,
    leftrule=3.5pt,
    sharp corners,
    rounded corners=all,
    arc=2pt,
    left=12pt,
    right=12pt,
    top=10pt,
    bottom=10pt,
    before skip=14pt,
    after skip=14pt,
    coltitle=defBlue,
    fonttitle=\bfseries\sffamily,
    separator sign={:\enspace},
    description font=\mdseries\itshape,
    attach title to upper={\par\vspace{5pt}}
}{def}

\newtcbtheorem[number within=chapter,crefname={theorem}{theorems}]{theorem}{Theorem}{%
    enhanced,
    breakable,
    colback=thmGreenBg,
    colframe=thmGreenLine,
    boxrule=0pt,
    leftrule=3.5pt,
    sharp corners,
    rounded corners=all,
    arc=2pt,
    left=12pt,
    right=12pt,
    top=10pt,
    bottom=10pt,
    before skip=14pt,
    after skip=14pt,
    coltitle=thmGreen,
    fonttitle=\bfseries\sffamily,
    separator sign={:\enspace},
    description font=\mdseries\itshape,
    attach title to upper={\par\vspace{5pt}}
}{thm}

% ------------------------------------------------------------------------------
% Code Listings Configuration
% ------------------------------------------------------------------------------
\definecolor{codeKw}{RGB}{0, 45, 120}
\definecolor{codeComment}{RGB}{110, 120, 130}
\definecolor{codeString}{RGB}{35, 135, 60}
\definecolor{codeNumber}{RGB}{160, 40, 110}
\definecolor{codeLineNo}{RGB}{160, 170, 180}

\lstdefinestyle{studyguidecode}{
    backgroundcolor=\color{codeBg},
    basicstyle=\small\ttfamily,
    keywordstyle=\bfseries\color{codeKw},
    commentstyle=\itshape\color{codeComment},
    stringstyle=\color{codeString},
    numberstyle=\tiny\color{codeLineNo},
    numbers=left,
    numbersep=8pt,
    stepnumber=1,
    showstringspaces=false,
    breaklines=true,
    breakatwhitespace=true,
    frame=single,
    rulecolor=\color{codeFrame},
    tabsize=4,
    captionpos=b,
    escapeinside={(*@}{@*)}
}

\lstdefinestyle{terminalOutput}{
    backgroundcolor=\color{codeBg},
    basicstyle=\small\ttfamily\color{bodyDark},
    numbers=none,
    frame=single,
    rulecolor=\color{codeFrame},
    breaklines=true,
    showstringspaces=false
}

\lstset{style=studyguidecode}

